# Variables de la recette de CGA Connect sur un hébergement cPanel (infra/cpanel/README.md).
# Copier, adapter, puis passer à build-package.sh : le fichier part dans le paquet sous le nom
# cpanel.env et install.sh le lit sur le serveur. Aucun mot de passe ici : celui de la base est
# demandé par install.sh à la première installation et ne va que dans le .env du serveur.

# --- Application ------------------------------------------------------------
# recette seulement : le mutualisé ne convient pas à la production (infra/README.md, décision 0011)
DEPLOY_ENV=recette
# Domaine unique du SPA et de l'API (02-TRD §3, T-01)
DOMAIN=recette.example.ci
# Dossier de l'application (versions, fichiers partagés, lien current), hors du dossier public
APP_DIR=$HOME/cga-connect
# Dossier public du domaine (cPanel > Domaines)
DOCROOT=$HOME/public_html/cga-connect
# Nombre de versions gardées pour un retour arrière
KEEP_RELEASES=3

# --- PHP ----------------------------------------------------------------------
# Vide : le php du PATH (8.3 ou plus exigé)
PHP_BIN=
PHP_MEMORY_LIMIT=256M
# Taille maximale d'un envoi en Mo : pièce de 10 Mo (files.max_upload_mb) + marge du formulaire
UPLOAD_MAX_MB=12
# Délai maximal d'une requête (s)
REQUEST_TIMEOUT_SECONDS=60

# --- Base PostgreSQL (cPanel > Bases de données PostgreSQL) -------------------
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=

# --- Tâches de fond : un cron chaque minute remplace Supervisor -------------
# Files traitées, dans cet ordre (infra/supervisor : un worker par file)
QUEUES=default,documents,notifications,imports,integrations
# Un passage du worker s'arrête quand les files sont vides, ou après cette durée (s)
WORKER_MAX_TIME_SECONDS=3000
# Sans flock sur le serveur : passage limité pour finir avant le cron suivant (s)
WORKER_NO_LOCK_MAX_TIME_SECONDS=50
WORKER_SLEEP_SECONDS=3

# --- En-têtes HTTP (mêmes valeurs que infra/infra.env.example) --------------
HSTS_MAX_AGE_SECONDS=31536000
# Cache des fichiers du SPA dont le nom porte une empreinte (s)
ASSETS_CACHE_SECONDS=31536000
CSP_POLICY="default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
# Délai des contrôles HTTP de fin d'installation (s)
CHECK_TIMEOUT_SECONDS=30

# --- Données de démonstration (recette seulement, jamais en production) -----
SEED_DEMO=true
# Compte de démonstration essayé en fin d'installation (gérant DC-KNOWING du DemoSeeder)
SMOKE_LOGIN_IDENTIFIER=0700000002
