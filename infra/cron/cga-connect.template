# CGA Connect — tâches planifiées (à copier dans /etc/cron.d/cga-connect, propriétaire root).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Planificateur Laravel, chaque minute : il lance les tâches du 02-TRD §11 à leurs horaires.
* * * * * ${APP_USER} cd ${APP_DIR}/current/backend && ${PHP_BIN} artisan schedule:run >> /dev/null 2>&1

# La sauvegarde de nuit est la tâche backup:run du planificateur (02-TRD §12.3, étape 9.1) : BACKUP_ENABLED=true dans
# backend/.env. scripts/backup.sh reste disponible pour une sauvegarde manuelle sous root (avant une opération risquée).
