; CGA Connect — workers des files d'attente, un programme par file (02-TRD §12.2)
; (à placer dans /etc/supervisor/conf.d/). Les tentatives et délais des Jobs sont dans config/queue-jobs.php.
; Tous les workers : supervisorctl restart cga-queues:*

[group:cga-queues]
programs=cga-queue-default,cga-queue-documents,cga-queue-notifications,cga-queue-imports

[program:cga-queue-default]
command=${PHP_BIN} ${APP_DIR}/current/backend/artisan queue:work --queue=default --sleep=${WORKER_SLEEP_SECONDS} --max-time=${WORKER_MAX_TIME_SECONDS}
process_name=%(program_name)s_%(process_num)02d
numprocs=${WORKERS_DEFAULT}
directory=${APP_DIR}/current/backend
user=${APP_USER}
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=${WORKER_STOP_WAIT_SECONDS}
redirect_stderr=true
stdout_logfile=${LOG_DIR}/queue-default.log
stdout_logfile_maxbytes=${WORKER_LOG_MAX_BYTES}
stdout_logfile_backups=${WORKER_LOG_BACKUPS}

[program:cga-queue-documents]
command=${PHP_BIN} ${APP_DIR}/current/backend/artisan queue:work --queue=documents --sleep=${WORKER_SLEEP_SECONDS} --max-time=${WORKER_MAX_TIME_SECONDS}
process_name=%(program_name)s_%(process_num)02d
numprocs=${WORKERS_DOCUMENTS}
; Un profil LibreOffice par worker (02-TRD §8.2).
environment=LIBREOFFICE_PROFILE_SLOT="%(process_num)02d"
directory=${APP_DIR}/current/backend
user=${APP_USER}
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=${WORKER_STOP_WAIT_SECONDS}
redirect_stderr=true
stdout_logfile=${LOG_DIR}/queue-documents.log
stdout_logfile_maxbytes=${WORKER_LOG_MAX_BYTES}
stdout_logfile_backups=${WORKER_LOG_BACKUPS}

[program:cga-queue-notifications]
