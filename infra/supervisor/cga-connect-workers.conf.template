process_name=%(program_name)s_%(process_num)02d
numprocs=${WORKERS_NOTIFICATIONS}
directory=${APP_DIR}/current/backend
user=${APP_USER}
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=${WORKER_STOP_WAIT_SECONDS}
redirect_stderr=true
stdout_logfile=${LOG_DIR}/queue-notifications.log
stdout_logfile_maxbytes=${WORKER_LOG_MAX_BYTES}
stdout_logfile_backups=${WORKER_LOG_BACKUPS}

[program:cga-queue-imports]
command=${PHP_BIN} ${APP_DIR}/current/backend/artisan queue:work --queue=imports --sleep=${WORKER_SLEEP_SECONDS} --max-time=${WORKER_MAX_TIME_SECONDS}
process_name=%(program_name)s_%(process_num)02d
numprocs=${WORKERS_IMPORTS}
directory=${APP_DIR}/current/backend
