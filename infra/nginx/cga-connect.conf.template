# CGA Connect — ${DOMAIN} (fichier produit par infra/scripts/render.sh depuis infra.env).
# Le SPA et l'API sont servis sur le même domaine, condition de la connexion par cookie (02-TRD §3, T-01).

limit_req_zone $binary_remote_addr zone=cga_health:1m rate=${HEALTH_RATE_LIMIT};

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:cga_ssl:10m;

    server_tokens off;
    client_max_body_size ${UPLOAD_MAX_MB}m;

    # En-têtes de sécurité (02-TRD §6.4). Aucune location ci-dessous n'utilise add_header :
    # Nginx n'hériterait plus de ces en-têtes.
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE_SECONDS}; includeSubDomains" always;
    add_header Content-Security-Policy "${CSP_POLICY}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    root ${APP_DIR}/current/frontend/dist;
    index index.html;

    # Fichiers cachés (.env, .git…) : jamais servis.
    location ~ /\. {
        deny all;
    }

    # Point de santé, surveillé chaque minute : limité par IP ici, sans dépendre de la base.
    location = /api/health {
        limit_req zone=cga_health burst=${HEALTH_RATE_BURST} nodelay;
        limit_req_status 429;
        include snippets/cga-connect-php.conf;
    }

    # API Laravel et cookie CSRF de Sanctum.
    location ~ ^/(api|sanctum)/ {
        include snippets/cga-connect-php.conf;
    }

    # Fichiers du SPA dont le nom porte une empreinte : mis en cache longtemps.
    location /assets/ {
        expires ${ASSETS_CACHE_DURATION};
        try_files $uri =404;
    }

    location = /index.html {
        expires -1;
    }

    # Toute autre adresse, dont la page publique /verifier/{jeton} : le SPA.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
