# Variables du serveur de CGA Connect (recette ou production).
# Copier dans /etc/cga-connect/infra.env (propriétaire root, droits 600), puis adapter.
# Elles alimentent les gabarits (scripts/render.sh), deploy.sh et backup.sh.

# --- Application ------------------------------------------------------------
# recette ou production (02-TRD §12.1)
DEPLOY_ENV=recette
# Domaine unique du SPA et de l'API (02-TRD §3, T-01)
DOMAIN=recette.cgaconnect.ci
# Dépôt Git et version déployée par défaut (branche, étiquette vX.Y.Z ou commit)
REPO_URL=git@github.com:organisation/cga-connect.git
DEPLOY_REF=main
# Dossier de l'application : releases/, shared/ et le lien current
APP_DIR=/var/www/cga-connect
# Nombre de versions gardées pour un retour arrière
KEEP_RELEASES=5
# Utilisateur système de PHP-FPM, des workers, du cron et des déploiements
APP_USER=cga
# Journaux des workers, du planificateur et des sauvegardes
LOG_DIR=/var/log/cga-connect

# --- PHP ----------------------------------------------------------------------
PHP_BIN=/usr/bin/php8.3
PHP_FPM_SERVICE=php8.3-fpm
PHP_FPM_SOCK=/run/php/php8.3-fpm-cga.sock
PHP_MEMORY_LIMIT=256M
# Processus PHP-FPM (serveur de 8 Go de RAM, 02-TRD §12.3)
FPM_MAX_CHILDREN=16
FPM_START_SERVERS=4
FPM_MIN_SPARE_SERVERS=2
FPM_MAX_SPARE_SERVERS=6
FPM_MAX_REQUESTS=500
# Taille maximale d'un envoi en Mo : pièce de 10 Mo (files.max_upload_mb) + marge du formulaire
UPLOAD_MAX_MB=12
# Délai maximal d'une requête API (s)
REQUEST_TIMEOUT_SECONDS=60
OPCACHE_MEMORY_MB=192
OPCACHE_MAX_FILES=20000

# --- Nginx --------------------------------------------------------------------
# Limitation du point de santé par adresse IP
HEALTH_RATE_LIMIT=30r/m
HEALTH_RATE_BURST=10
# Durée de HSTS (s) et du cache des fichiers du SPA dont le nom porte une empreinte
HSTS_MAX_AGE_SECONDS=31536000
ASSETS_CACHE_DURATION=1y
# En-tête Content-Security-Policy (02-TRD §6.4 : CSP stricte)
CSP_POLICY="default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

# --- Workers des files d'attente (Supervisor, 02-TRD §12.2) -----------------
WORKERS_DEFAULT=2
# Une seule conversion PDF à la fois au démarrage (documents.workers, 02-TRD §8.2)
WORKERS_DOCUMENTS=1
WORKERS_NOTIFICATIONS=1
WORKERS_IMPORTS=1
WORKER_SLEEP_SECONDS=3
# Un worker se relance après cette durée (s), pour libérer la mémoire
WORKER_MAX_TIME_SECONDS=3600
# Temps laissé à un Job en cours pour finir lors d'un arrêt (s)
WORKER_STOP_WAIT_SECONDS=330
WORKER_LOG_MAX_BYTES=10MB
WORKER_LOG_BACKUPS=5

# --- Sauvegardes (02-TRD §12.3) ---------------------------------------------
# Heure de la sauvegarde de nuit (syntaxe cron) : 04:00
BACKUP_CRON="0 4 * * *"
BACKUP_DIR=/var/backups/cga-connect
# Semaines de journaux de sauvegarde gardées
BACKUP_LOG_ROTATE_WEEKS=8
BACKUP_RETENTION_DAYS=30
# Jour de la sauvegarde complète des fichiers (1 = lundi … 7 = dimanche) ; les autres jours sont incrémentaux
BACKUP_FULL_WEEKDAY=7
# Clé publique GPG qui chiffre les sauvegardes (la clé privée reste hors du serveur)
BACKUP_GPG_RECIPIENT=sauvegardes@cgaconnect.ci
# Copie hors du serveur (rsync sur SSH), ex. sauvegarde@stockage.example:/srv/cga-connect ; vide = pas de copie (alerte)
BACKUP_REMOTE=
# Base sauvegardée
DB_NAME=cga_plateforme
