# Analyse statique (02-TRD §4.2 : Larastan niveau 6). env() hors de config/ est refusé
# par la règle noEnvCallsOutsideOfConfig de Larastan (02-TRD §7.6).
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
    noEnvCallsOutsideOfConfig: true

# Règles de sécurité du projet (02-TRD §6.7) : données de requête non validées, SQL brut non constant.
rules:
    - Tools\PHPStan\Rules\NoUnvalidatedRequestDataRule
    - Tools\PHPStan\Rules\NoRawSqlWithVariableRule
