APP_NAME="CGA Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Adresse du SPA dans les liens envoyés (activation) ; en recette et en production, celle de APP_URL.
FRONTEND_URL=http://localhost:5173

# Fuseau et langue de l'application (02-TRD §7.2) ; les textes manquants en français retombent sur l'anglais.
APP_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16 ou plus, avec les extensions pg_trgm, unaccent et citext (02-TRD §12.1).
# Les tests utilisent la base cga_plateforme_test (phpunit.xml), avec le même utilisateur.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cga_plateforme
DB_USERNAME=cga_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de session HTTPS seulement : true (défaut) en recette et en production ; false sur le poste local en http.
SESSION_SECURE_COOKIE=false

# Recopie du code envoyé (SMS ou e-mail) dans la réponse, pour essayer les parcours sans téléphone.
# Ne fonctionne qu'avec APP_ENV=local et un pilote d'envoi « log » ; à laisser à false ailleurs.
AUTH_ECHO_DEV_MESSAGES=true

# Sanctum en mode SPA (02-TRD §6.1). Le domaine de APP_URL est toujours retenu ; ajouter ici le
# serveur Vite du poste local. En recette et en production (même domaine), laisser vide.
SANCTUM_STATEFUL_DOMAINS=localhost:5173
# Origines autorisées à appeler l'API avec le cookie (CORS) : aucune par défaut (même domaine).
# Sur le poste local, le SPA de développement s'il appelle l'API directement.
CORS_ALLOWED_ORIGINS=http://localhost:5173

BROADCAST_CONNECTION=log
# Disque des fichiers (02-TRD §6.4) : private (disque du serveur, hors racine web) ; s3 après une bascule.
FILESYSTEM_DISK=private
# Dossier racine du disque private (défaut : storage/app/private).
# FILES_ROOT=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Erreurs envoyées à Sentry (02-TRD §12.3) : vide = désactivé.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Binaire de LibreOffice (conversion PDF, 02-TRD §8.2). Linux : soffice (dans le PATH).
# Windows : le programme console soffice.com, pas soffice.exe, entre guillemets simples, par exemple
# LIBREOFFICE_BIN='C:\Program Files\LibreOffice\program\soffice.com'
LIBREOFFICE_BIN=soffice

# Adresse de la page publique de vérification d'un document, suivie du jeton dans le QR code
# (F-DOC-04, 02-TRD §8.2). Vide : FRONTEND_URL/verifier.
DOCUMENT_VERIFICATION_URL=

# Adresse IP d'une consultation de cette page, gardée tronquée à son réseau (RG-DOC-09) : longueur du
# préfixe en bits, en IPv4 et en IPv6.
DOCUMENT_VERIFICATION_IPV4_PREFIX=24
DOCUMENT_VERIFICATION_IPV6_PREFIX=48

# Certification FNE (02-TRD §10 bis.1) : hôtes autorisés pour l'adresse du service saisie par chaque
# centre (liste blanche, séparés par des virgules ; vide : aucun mode API possible) et délai maximal
# d'un appel (s). Les identifiants restent par centre, chiffrés en base, jamais ici.
FNE_ALLOWED_HOSTS=
FNE_HTTP_TIMEOUT=30

# Délai maximal (secondes) du contrôle de LibreOffice par GET /api/health, nettement sous la limite
# d'une requête PHP (max_execution_time, 30 s par défaut).
HEALTH_LIBREOFFICE_TIMEOUT_SECONDS=15

# Premier administrateur de la plateforme, créé par le seeder (php artisan db:seed) si son téléphone
# est renseigné (format +225XXXXXXXXXX). Il active son compte par invitation.
SEED_PLATFORM_ADMIN_PHONE=
SEED_PLATFORM_ADMIN_EMAIL=

# Jeu de démonstration (comptes fictifs) : poste de développement et recette seulement.
SEED_DEMO=true
