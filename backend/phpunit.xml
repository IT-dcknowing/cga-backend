<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <testsuite name="Tooling">
            <directory>tests/Tooling</directory>
        </testsuite>
    </testsuites>
    <!-- Les durées (02-TRD §12) se mesurent seules, sans couverture ni tests en parallèle : composer test:performance. -->
    <groups>
        <exclude>
            <group>performance</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Les tests des règles PHPStan chargent Larastan : la limite par défaut de PHP ne suffit pas. -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="AUTH_ECHO_DEV_MESSAGES" value="false"/>
        <env name="SEED_DEMO" value="false"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="database"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="cga_plateforme_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="database"/>
        <env name="FRONTEND_URL" value="http://localhost:5173"/>
        <env name="SESSION_DRIVER" value="database"/>
        <env name="SESSION_SECURE_COOKIE" value="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5173"/>
        <env name="CORS_ALLOWED_ORIGINS" value="http://localhost:5173"/>
        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
